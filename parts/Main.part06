local function makeDraggable(
handle,
target
)
local dragging =
false
local dragInput =
nil
local dragStart =
nil
local startPosition =
nil
local function clampPosition(
x,
y
)
local camera =
Workspace.CurrentCamera
if not camera then
return x, y
end
local viewport =
camera.ViewportSize
local size =
target.AbsoluteSize
return
math.clamp(
x,
0,
math.max(
0,
viewport.X
- size.X
)
),
math.clamp(
y,
0,
math.max(
0,
viewport.Y
- size.Y
)
)
end
trackRbx(
handle.InputBegan:Connect(
function(input)
if input.UserInputType
== Enum.UserInputType.MouseButton1
or input.UserInputType
== Enum.UserInputType.Touch then
dragging =
true
dragStart =
input.Position
startPosition =
target.AbsolutePosition
end
end
)
)
trackRbx(
handle.InputChanged:Connect(
function(input)
if input.UserInputType
== Enum.UserInputType.MouseMovement
or input.UserInputType
== Enum.UserInputType.Touch then
dragInput =
input
end
end
)
)
trackRbx(
UserInputService.InputChanged:Connect(
function(input)
if not dragging
or input ~= dragInput
or not dragStart
or not startPosition then
return
end
local delta =
input.Position
- dragStart
local x =
startPosition.X
+ delta.X
local y =
startPosition.Y
+ delta.Y
x, y =
clampPosition(
x,
y
)
target.Position =
UDim2.fromOffset(
x,
y
)
end
)
)
trackRbx(
UserInputService.InputEnded:Connect(
function(input)
if input.UserInputType
== Enum.UserInputType.MouseButton1
or input.UserInputType
== Enum.UserInputType.Touch then
dragging =
false
dragInput =
nil
end
end
)
)
end
makeDraggable(
header,
frame
)
makeDraggable(
mini,
mini
)
