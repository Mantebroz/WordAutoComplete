end
local function updateAttempts()
if C.StrikeCount ~= nil then
C.AttemptsRemaining =
math.max(
0,
MAX_STRIKES
- C.StrikeCount
)
else
C.AttemptsRemaining =
nil
end
if C.AttemptsLabel then
if C.AttemptsRemaining == nil then
C.AttemptsLabel.Text =
"INTENTOS  •  ? / "
.. tostring(
MAX_STRIKES
)
else
C.AttemptsLabel.Text =
"INTENTOS  •  "
.. tostring(
C.AttemptsRemaining
)
.. " / "
.. tostring(
MAX_STRIKES
)
end
end
end
