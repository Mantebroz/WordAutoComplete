 then
return 78
elseif count <= 10 then
return 60
elseif count <= 20 then
return 43
elseif count <= 40 then
return 28
elseif count <= 80 then
return 14
end
return 0
end
local function bankDifficulty(word)
word =
normalize(word)
local last =
word:sub(-1)
local score =
HARD_ENDING_SCORE[
last
]
or EASY_ENDING_SCORE[
last
]
or 0
score += scarcityScore(
countBankContinuations(
last
)
)
if #word >= 4
and #word <= 10 then
score += 8
end
if #word > 14 then
score -= 15
end
return score
end
local function findStrategicBankWord(prefix)
local candidates =
collectBankCandidates(
prefix,
BANK_STRATEGY_CANDIDATES
)
local bestWord = nil
local bestScore =
-math.huge
for _, word in ipairs(
candidates
) do
local score =
bankDifficulty(
word
)
if score > bestScore then
bestScore =
score
bestWord =
word
end
end
return bestWord,
bestScore
end
local function httpGet(url)
if type(request)
== "function" then
local ok, response =
pcall(function()
return request({
Url = url,
Method = "GET"
})
end)
if ok and response then
local body =
response.Body
or response.body
if type(body)
== "string"
and #body > 0 then
return body
end
end
end
if type(http_request)
== "function" then
local ok, response =
pcall(function()
return http_request({
Url = url,
Method = "GET"
})
end)
if ok and response then
local body =
response.Body
or response.body
if type(body)
== "string"
and #body > 0 then
return body
end
end
end
if syn
and type(
syn.request
) == "function" then
local ok, response =
pcall(function()
return syn.request({
Url = url,
Method = "GET"
})
end)
if ok and response then
local body =
response.Body
or response.body
if type(body)
== "string"
and #body > 0 then
return body
end
end
end
local ok, body =
pcall(function()
return game:HttpGet(
url
)
end)
if ok
and type(body)
== "string"
and #body > 0 then
return body
end
return nil
end
local function addCommonWord(word)
word =
normalize(word)
if not externalWordLooksOkay(
word
) then
return
end
if C.CommonSeen[
word
]
or memoryBlacklisted(
word
) then
return
end
if C.Bank
and not bankContainsWord(
word
) then
return
end
C.CommonSeen[
word
] = true
table.insert(
C.CommonWords,
word
)
C.CommonRank[
word
] =
#C.CommonWords
local p1 =
word:sub(
1,
1
)
C.CommonBuckets1[p1] =
C.CommonBuckets1[p1]
or {}
table.insert(
C.CommonBuckets1[p1],
word
)
if #word >= 2 then
local p2 =
word:sub(
1,
2
)
C.CommonBuckets2[p2] =
C.CommonBuckets2[p2]
or {}
table.insert(
C.CommonBuckets2[p2],
word
)
end
end
local function addHugeWord(word)
word =
normalize(word)
if not externalWordLooksOkay(
word
) then
return
end
if C.CommonSeen[word]
or C.HugeSeen[word]
or memoryBlacklisted(
word
) then
return
end
if C.Bank
and not bankContainsWord(
word
) then
return
end
C.HugeSeen[
word
] = true
table.insert(
C.HugeWords,
word
)
local p1 =
word:sub(
1,
1
)
C.HugeBuckets1[p1] =
C.HugeBuckets1[p1]
or {}
table.insert(
C.HugeBuckets1[p1],
word
)
if #word >= 2 then
local p2 =
word:sub(
1,
2
)
C.HugeBuckets2[p2] =
C.HugeBuckets2[p2]
or {}
table.insert(
C.HugeBuckets2[p2],
word
)
end
end
local function loadCommonDictionary()
if C.CommonLoading
or C.CommonReady then
return
end
C.CommonLoading =
true
for _, word in ipairs(
SAFE_SEEDS
) do
addCommonWord(
word
)
end
C.CommonReady =
#C.CommonWords > 0
updateBankLabel()
local url =
"https"
.. "://raw.githubusercontent.com/"
.. "first20hours/"
.. "google-10000-english/"
.. "master/"
.. "google-10000-english.txt"
local text =
httpGet(url)
if text then
local processed = 0
for line in text:gmatch(
"[^\r\n]+"
) do
addCommonWord(
line
)
processed += 1
if processed
% DICTIONARY_YIELD_EVERY
== 0 then
updateBankLabel()
task.wait()
end
end
end
C.CommonLoading =
false
C.CommonReady =
#C.CommonWords > 0
updateBankLabel()
print(
"✓ COMMON:",
#C.CommonWords
)
if C.Enabled
and C.ScheduleCurrentRound then
C.ScheduleCurrentRound()
end
end
local function loadHugeDictionary()
if C.HugeLoading
or C.HugeReady then
return
end
C.HugeLoading =
true
updateBankLabel()
local url =
"https"
.. "://raw.githubusercontent.com/"
.. "dwyl/"
.. "english-words/"
.. "master/"
.. "words_alpha.txt"
local text =
httpGet(url)
if text then
local processed = 0
for line in text:gmatch(
"[^\r\n]+"
) do
addHugeWord(
line
)
processed += 1
if processed
% DICTIONARY_YIELD_EVERY
== 0 then
updateBankLabel()
task.wait()
end
end
end
C.HugeLoading =
false
C.HugeReady =
#C.HugeWords > 0
updateBankLabel()
print(
"✓ HUGE FALLBACK:",
#C.HugeWords
)
if C.Enabled
and C.ScheduleCurrentRound then
C.ScheduleCurrentRound()
end
end
local function getCommonList(prefix)
prefix =
normalize(prefix)
if #prefix >= 2 then
return C.CommonBuckets2[
prefix:sub(
1,
2
)
]
elseif #prefix == 1 then
return C.CommonBuckets1[
prefix
]
end
return C.CommonWords
end
local function getHugeList(prefix)
prefix =
normalize(prefix)
if #prefix >= 2 then
return C.HugeBuckets2[
prefix:sub(
1,
2
)
]
elseif #prefix == 1 then
return C.HugeBuckets1[
prefix
]
end
return C.HugeWords
end
local function usableExternalWord(
word,
prefix
)
return externalWordLooksOkay(
word
)
and #word > #prefix
and startsWith(
word,
prefix
)
and not C.TriedWords[
word
]
and not C.UsedWords[
word
]
and not C.DeniedWords[
word
]
and not memoryBlacklisted(
word
)
end
local function findNormalCommonWord(prefix)
prefix =
normalize(prefix)
local list =
getCommonList(
prefix
)
if not list then
return nil
end
for _, word in ipairs(
list
) do
if usableExternalWord(
word,
prefix
) then
return word
end
end
return nil
end
local function commonDifficulty(word)
word =
normalize(word)
local last =
word:sub(-1)
local score =
HARD_ENDING_SCORE[
last
]
or EASY_ENDING_SCORE[
last
]
or 0
local rank =
C.CommonRank[
word
]
or 10000
score += math.max(
0,
30 - (
rank / 250
)
)
if #word >= 4
and #word <= 10 then
score += 10
end
if #word > 14 then
score -= 20
end
return score
end
local function findStrategicCommonWord(prefix)
prefix =
normalize(prefix)
local list =
getCommonList(
prefix
)
if not list then
return nil, nil
end
local bestWord = nil
local bestScore =
-math.huge
local checked = 0
for _, word in ipairs(
list
) do
if usableExternalWord(
word,
prefix
) then
checked += 1
local score =
commonDifficulty(
word
)
if score > bestScore then
bestScore =
score
bestWord =
word
end
if checked
>= COMMON_STRATEGY_CANDIDATES then
break
end
end
end
return bestWord,
bestScore
end
local function findHugeFallback(prefix)
prefix =
normalize(prefix)
local list =
getHugeList(
prefix
)
if not list then
return nil
end
for _, word in ipairs(
list
) do
if usableExternalWord(
word,
prefix
) then
return word
end
end
return nil
end
local function findSpecialXWord(prefix)
if not WordMemory
or type(WordMemory.getXWords)
~= "function" then
return nil
end
prefix =
normalize(prefix)
local ok, candidates =
pcall(
WordMemory.getXWords,
prefix
)
if not ok
or type(candidates)
~= "table" then
return nil
end
for _, word in ipairs(
candidates
) do
word =
normalize(word)
if word ~= ""
and externalWordLooksOkay(
word
)
and #word > #prefix
and startsWith(
word,
prefix
)
and word:sub(-1)
== "x"
and not C.TriedWords[
word
]
and not C.UsedWords[
word
]
and not C.DeniedWords[
word
]
and not memoryBlacklisted(
word
) then
if not C.Bank
or bankContainsWord(
word
) then
return word
end
end
end
return nil
end
local function chooseWord(
prefix,
forceSafe
)
prefix =
normalize(prefix)
local safe =
forceSafe == true
or C.ForceSafeNext == true
or C.SafePrefixes[
prefix
] == true
if safe then
local bank =
findNormalBankWord(
prefix
)
if bank then
return bank,
"REAL BANK • SAFE",
0,
true
end
local common =
findNormalCommonWord(
prefix
)
if common then
return common,
"COMMON • SAFE",
0,
true
end
local huge =
findHugeFallback(
prefix
)
if huge then
return huge,
"FALLBACK • SAFE",
0,
true
end
return nil,
nil,
nil,
true
end
local xWord =
findSpecialXWord(
prefix
)
if xWord then
return xWord,
C.Bank
and "X BANK • VERIFIED"
or "X BANK",
HARD_ENDING_SCORE.x,
false
end
if C.Bank then
local strategic,
score =
findStrategicBankWord(
prefix
)
if strategic then
return strategic,
"REAL BANK • STRATEGY",
score,
false
end
local normal =
findNor