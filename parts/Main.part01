local function normalize(text)
if type(text)
~= "string" then
return ""
end
return string.lower(
text
:gsub("^%s+", "")
:gsub("%s+$", "")
)
end
local function memoryBlacklisted(word)
if not WordMemory
or type(WordMemory.isBlacklisted)
~= "function" then
return false
end
local ok, result =
pcall(
WordMemory.isBlacklisted,
word
)
return ok
and result == true
end
local function startsWith(
word,
prefix
)
if type(word) ~= "string"
or type(prefix) ~= "string" then
return false
end
return word:sub(
1,
#prefix
) == prefix
end
local function tableCount(tbl)
local result = 0
for _ in pairs(tbl) do
result += 1
end
return result
end
local function bankWordLooksOkay(word)
word =
normalize(word)
if word == "" then
return false
end
if #word < 2
or #word > MAX_WORD_LENGTH then
return false
end
if not word:match(
"^[a-z]+$"
) then
return false
end
return true
end
local function externalWordLooksOkay(word)
word =
normalize(word)
if word == "" then
return false
end
if #word < 4
or #word > MAX_WORD_LENGTH then
return false
end
if not word:match(
"^[a-z]+$"
) then
return false
end
if EXTERNAL_DENY[
word
] then
return false
end
if not word:find(
"[aeiouy]"
) then
return false
end
return true
end
local function samePlayer(value)
if value == player then
return true
end
if typeof(value)
== "Instance"
and value:IsA(
"Player"
) then
return value.UserId
== player.UserId
end
if tonumber(value)
== player.UserId then
return true
end
if tostring(value)
== player.Name then
return true
end
return false
end
local function isOurTurn()
if samePlayer(
C.TurnPlayer
) then
return true
end
return player:GetAttribute(
"IsTurn"
) == true