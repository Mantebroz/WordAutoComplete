local function startDelay(retry)
if retry then
return RNG:NextNumber(
RETRY_START_DELAY_MIN,
RETRY_START_DELAY_MAX
)
end
return RNG:NextNumber(
START_DELAY_MIN,
START_DELAY_MAX
)
end
local function keyDelay()
return RNG:NextNumber(
MIN_KEY_DELAY,
MAX_KEY_DELAY
)
end
local function submitDelay()
return RNG:NextNumber(
MIN_SUBMIT_DELAY,
MAX_SUBMIT_DELAY
)
end
local function clearDelay()
return RNG:NextNumber(
MIN_CLEAR_DELAY,
MAX_CLEAR_DELAY
)
end
if _G.AutoWordMaster
and _G.AutoWordMaster.Destroy then
pcall(function()
_G.AutoWordMaster:Destroy()
end)
end
if _G.AutoWordDirect
and _G.AutoWordDirect.Destroy then
pcall(function()
_G.AutoWordDirect:Destroy()
end)
end
local function importGameModule(
name,
timeout
)
local deadline =
os.clock()
+ (timeout or 15)
repeat
if type(_G.import)
== "function" then
local ok, result =
pcall(function()
return _G.import(name)
end)
if ok
and result then
return result
end
end
task.wait(0.10)
until os.clock()
>= deadline
return nil
end
local function loadEventModule()
local services =
ReplicatedStorage:FindFirstChild(
"Services"
)
local communication =
services
and services:FindFirstChild(
"Communication"
)
local eventModule =
communication
and communication:FindFirstChild(
"event"
)
if eventModule
and eventModule:IsA(
"ModuleScript"
) then
local ok, result =
pcall(
require,
eventModule
)
if ok
and type(result)
== "table"
and type(
result.fire
) == "function" then
print(
"✓ EVENT MODULE:",
eventModule:GetFullName()
)
return result
end
warn(
"[AUTO WORD] Falló require directo:",
result
)
end
for _, object in ipairs(
ReplicatedStorage:GetDescendants()
) do
if object:IsA(
"ModuleScript"
)
and string.lower(
object.Name
) == "event" then
local ok, result =
pcall(
require,
object
)
if ok
and type(result)
== "table"
and type(
result.fire
) == "function" then
print(
"✓ EVENT MODULE fallback:",
object:GetFullName()
)
return result
end
end
end
return nil
end
local Event =
loadEventModule()
if not Event then
error(
"[AUTO WORD] No encontré/cargué el módulo event."
)
end
print(
"✓ Event.fire:",
type(Event.fire)
)
print(
"✓ Event.remoteFire:",
type(Event.remoteFire)
)
print(
"✓ Event.remoteConnect:",
type(Event.remoteConnect)
)
if type(Event.fire) ~= "function"
or type(Event.remoteConnect) ~= "function" then
error(
"[AUTO WORD] El módulo event no tiene la API esperada."
)
end
